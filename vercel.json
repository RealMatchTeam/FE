{
  "buildCommand": "pnpm run build",
  "outputDirectory": "build/client",
  "framework": null,
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.realmatch.co.kr/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "realmatch.co.kr" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.realmatch.co.kr/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
